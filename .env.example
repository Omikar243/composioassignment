# Server Configuration
PORT=3001

# Optional AI-Assisted Research (Mode B)
# If provided, the Live Investigator can use Google Gemini, Groq, or OpenAI to parse unstructured documentation.
# If omitted, the engine uses deterministic heuristic research (Mode 2); no AI provider is called.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional Groq model override; defaults to openai/gpt-oss-20b.
GROQ_MODEL=
OPENAI_API_KEY=
